{
  "manifest_version": 2,
  "name": "JS Toggle",
  "version": "2.0.0",
  "description": "Toolbar button to toggle JavaScript per tab, with a pre-defined disabled-sites list.",
  "permissions": [
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-on.svg",
    "96": "icons/icon-on.svg"
  },
  "browser_action": {
    "default_icon": "icons/icon-on.svg",
    "default_title": "JS Toggle"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{b77f09de-6558-40e1-b199-55abb0a2bd44}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
